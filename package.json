{
  "name": "a11y-lens",
  "version": "0.1.0",
  "description": "Локальное browser extension для проверки accessibility текущей страницы.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "icons:generate": "node scripts/run-commands.mjs icons-generate node scripts/generate-icons.mjs",
    "dev": "node scripts/run-commands.mjs dev node scripts/generate-icons.mjs ::: wxt",
    "dev:firefox": "node scripts/run-commands.mjs dev-firefox node scripts/generate-icons.mjs ::: wxt -b firefox",
    "build": "node scripts/run-commands.mjs build node scripts/generate-icons.mjs ::: wxt build",
    "build:firefox": "node scripts/run-commands.mjs build-firefox node scripts/generate-icons.mjs ::: wxt build -b firefox",
    "zip": "node scripts/run-commands.mjs zip wxt zip",
    "zip:firefox": "node scripts/run-commands.mjs zip-firefox wxt zip -b firefox",
    "typecheck": "node scripts/run-commands.mjs typecheck tsc --noEmit",
    "test": "node scripts/run-commands.mjs test vitest run",
    "test:coverage": "node scripts/run-commands.mjs test-coverage vitest run --coverage",
    "test:e2e": "node scripts/run-commands.mjs test-e2e playwright test",
    "test:e2e:install": "node scripts/run-commands.mjs playwright-install playwright install chromium",
    "lint": "node scripts/run-commands.mjs lint eslint . --max-warnings=0",
    "format": "node scripts/run-commands.mjs format prettier . --write",
    "format:check": "node scripts/run-commands.mjs format-check prettier . --check",
    "manifest:check": "node scripts/run-commands.mjs manifest-check node scripts/check-manifest.mjs",
    "extension:check": "node scripts/run-commands.mjs extension-check node scripts/check-extension-package.mjs",
    "reproducibility:check": "node scripts/run-commands.mjs reproducibility-check node scripts/check-reproducibility.mjs",
    "security:check": "node scripts/run-commands.mjs security-check node scripts/check-security-dependencies.mjs",
    "docs:check": "node scripts/run-commands.mjs docs-check node scripts/check-docs.mjs",
    "release:check-tag": "node scripts/run-commands.mjs release-check-tag node scripts/check-release-tag.mjs",
    "verify": "node scripts/run-commands.mjs verify npm run format:check ::: npm run lint ::: npm run typecheck ::: npm test ::: npm run build ::: npm run build:firefox ::: npm run manifest:check ::: npm run extension:check ::: npm run security:check ::: npm run docs:check"
  },
  "dependencies": {
    "axe-core": "4.13.0",
    "dom-accessibility-api": "0.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "5.0.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0",
    "vite": "8.2.1",
    "web-ext": "9.4.0",
    "wxt": "0.21.4"
  }
}
